# Backend API base URL
VITE_API_URL=https://occasion-catering-production.up.railway.app/api

# EmailJS — used to send the booking confirmation email straight from the
# browser once a booking is confirmed. Create a free account at
# https://www.emailjs.com/, add an Email Service and a Template, then copy
# the IDs below. See the Template section in this file's comments for the
# variables the app sends.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# EmailJS template variables sent by the app (map these in your EmailJS
# template body, and set the template's "To Email" field to {{to_email}}):
#   to_name, to_email, booking_id, booking_ref, event_date, event_time,
#   guest_count, package_list, total_amount, special_requests
